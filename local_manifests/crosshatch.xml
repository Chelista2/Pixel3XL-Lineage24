<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="mine"
          fetch="https://github.com/Chelista2/"
          revision="lineage-24.0" />

  <!-- Device & Vendor Trees (zuerst mit i928-Forks starten und auf A17 anpassen) -->
  <project path="device/google/crosshatch"
           name="android_device_google_crosshatch"
           remote="mine" />
  <project path="vendor/google/crosshatch"
           name="proprietary_vendor_google_crosshatch"
           remote="mine" />

  <!-- Kernel 4.9 von i928 -->
  <project path="kernel/google/msm-4.9"
           name="android_kernel_google_msm-4.9"
           remote="mine" />

  <!-- Gepatchte System-Repos für den 4.9-Kernel -->
  <project path="packages/modules/Connectivity"
           name="android_packages_modules_Connectivity"
           remote="mine" />
  <project path="bionic"
           name="android_bionic"
           remote="mine" />
  <project path="system/memory/libmeminfo"
           name="android_system_memory_libmeminfo"
           remote="mine" />
</manifest>
